# Используется только при локальном "npm run dev" (см. vite.config.js) —
# на какой адрес проксировать "/api/*" вместо запущенного docker-compose.
# По умолчанию (без .env) — http://localhost:8000, т.е. gateway, поднятый
# через docker-compose (см. корневой docker-compose.yml, порт 8000:8000).
# В самом собранном контейнере (Dockerfile+nginx.conf) этот файл не участвует —
# там адрес шлюза зашит в nginx.conf как "miklat-gateway:8000" (DNS-имя
# внутри docker-compose network).
VITE_GATEWAY_URL=http://localhost:8000
