# Скопировать в terraform.tfvars (этот файл в git не попадает — см. .gitignore)
# и заполнить реальными значениями. Всё, что не переопределено здесь, возьмёт
# значение по умолчанию из variables.tf.

# Профиль AWS CLI. ВАЖНО: "alex_goldenberg" здесь раньше был неверным
# предположением — это имя IAM-пользователя в AWS, а не обязательно имя
# ИМЕНОВАННОГО профиля в ~/.aws/credentials (это разные вещи: профиль
# получает конкретное имя только если явно делать `aws configure --profile
# <имя>`, иначе всё пишется в профиль "default"). Проверить, что реально
# есть: `aws configure list-profiles`. Если там либо ничего, либо только
# "default" — оставить это поле пустым (см. значение ниже), Terraform
# возьмёт default-профиль сам.
aws_profile = ""

# Обязательно: твой текущий ВНЕШНИЙ IPv4 (не IPv6!), чтобы не открывать SSH
# всему интернету. security_groups.tf использует cidr_blocks — это поле
# в AWS/Terraform принимает только IPv4 CIDR, IPv6-адрес туда не годится
# (даже синтаксически "/32" для IPv6 означает совсем не то, что для IPv4).
# Узнать ИМЕННО IPv4 (Git Bash / PowerShell): curl.exe -4 ifconfig.me
# — добавить "/32".
ssh_allowed_cidr = "1.2.3.4/32"

# Обязательно: путь к ПУБЛИЧНОМУ ключу (не приватному!). Если пары ещё нет:
#   ssh-keygen -t ed25519 -f ~/.ssh/miklat-devops -C "miklat-devops"
# На Windows указывать полным путём с буквой диска и прямыми слешами
# (C:/Users/<имя>/.ssh/miklat-devops.pub) — НЕ "~/..." и НЕ MSYS-стиль
# "/c/Users/...": terraform.exe — нативный Windows-бинарник, он не понимает
# путь без буквы диска (тот же класс проблемы, что и MSYS-конвертация путей
# в Docker-командах, см. miklat-progress.md).
ssh_public_key_path = "C:/Users/Alex/.ssh/miklat-devops.pub"

# Обязательно: пароль для master-пользователя RDS (придумать самостоятельно,
# нигде не хранить кроме этого файла и, при желании, менеджера паролей).
db_password = "change-me"

# Обязательно (добавлено в Фазе 3, Задание 3): публичный IPv4 сервера mbdai,
# на котором развёрнут k3s — этот сервер вне AWS VPC, поэтому доступ к RDS
# для него нельзя дать по членству в Security Group (как у backend/worker
# EC2 выше), только явным CIDR. Тот же принцип, что у ssh_allowed_cidr —
# конкретный /32, не 0.0.0.0/0.
mbdai_public_ip = "83.229.70.64/32"
