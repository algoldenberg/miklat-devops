DATABASE_URL=postgresql://miklat:miklat_dev_password@localhost:5432/miklat
ADMIN_API_KEY=change-me-to-a-random-secret

# Dev-ресурсы, создаются один раз вручную (Фаза 1, шаг 9 work-plan) —
# ограниченный IAM-пользователь: только s3:PutObject/GetObject на бакет ниже
# и sns:Publish на топик ниже.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
S3_BUCKET_NAME=miklat-photos-dev-change-me
SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:000000000000:miklat-notifications

# Необязательные настройки (значения по умолчанию заданы в app/config.py)
# PHOTO_URL_EXPIRY_SECONDS=3600
# MAX_PHOTO_SIZE_BYTES=8388608
