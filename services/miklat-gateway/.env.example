# Внутри docker-compose это DNS-имена сервисов (имя сервиса = hostname);
# при локальном запуске gateway ВНЕ docker-compose (uvicorn --reload) —
# localhost с портами, под которые они замаплены наружу (см. docker-compose.yml).
MIKLAT_SERVICE_URL=http://localhost:8001
MIKLAT_COMMENTS_URL=http://localhost:8002
MIKLAT_ROUTES_URL=http://localhost:8003
MIKLAT_WALKING_ROUTES_URL=http://localhost:8004
MIKLAT_PHOTOS_URL=http://localhost:8005

# UPSTREAM_TIMEOUT_S=15
