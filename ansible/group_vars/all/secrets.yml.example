# Скопировать в secrets.yml (этот файл в git не попадает — см. .gitignore)
# и заполнить реальными значениями из `terraform output` (папка terraform/)
# и из terraform.tfvars (db_password, который ты сам придумал).
#
# Не секрет в строгом смысле, но тоже отсюда — приватные IP и имя бакета/ARN
# топика меняются при каждом terraform apply/destroy, поэтому лежат в одном
# файле с паролями, чтобы обновлять было проще (один файл после каждого
# apply), а не потому что это чувствительные данные сами по себе.

aws_region: "il-central-1"

# terraform output db_endpoint выглядит как "host:5432" — сюда только host,
# без порта (порт уже отдельно в vars.yml как db_port).
db_host: "miklat-db.c986msyg4duz.il-central-1.rds.amazonaws.com"
db_password: "MiklatTest"

# Тот же ключ, что уже используется для X-Admin-Key в локальной разработке —
# можно оставить таким же или придумать другой, сервисам всё равно, главное
# чтобы совпадало с тем, что будешь передавать в заголовке при проверке.
admin_api_key: "MiklatTest"

s3_bucket_name: "miklat-photos-tf-232779827681"
sns_topic_arn: "arn:aws:sns:il-central-1:232779827681:miklat-notifications-tf"

# terraform output backend_private_ip / worker_private_ip
backend_private_ip: "10.20.1.0"
worker_private_ip: "10.20.1.0"
