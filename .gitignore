# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# OSRM (сгенерированные данные — карта + предобработанный граф, воспроизводится
# скриптом osrm/prepare-data.sh, в git не нужны)
osrm/data/

# Node / frontend
node_modules/
frontend/dist/
.vite/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
!*.example.*

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/.terraform.lock.hcl
terraform/*.tfvars
!terraform/*.tfvars.example

# Ansible
ansible/*.retry
ansible/group_vars/vault.yml

# Kubernetes secrets (real ones must never be committed)
k8s/**/secret.yaml
!k8s/**/secret.example.yaml

# Jenkins
jenkins/**/credentials.xml

# OS / editor
.DS_Store
.idea/
.vscode/
