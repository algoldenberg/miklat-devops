# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# OSRM (сгенерированные данные — карта + предобработанный граф, воспроизводится
# скриптом osrm/prepare-data.sh, в git не нужны)
osrm/data/

# Node / frontend
node_modules/
frontend/dist/
.vite/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
!*.example.*

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example
# .terraform.lock.hcl НЕ игнорируется (было ошибочно исключено ещё в Фазе 0,
# до появления самого Terraform-кода) — этот файл наоборот нужно коммитить:
# он фиксирует конкретную версию+хэши провайдера, чтобы `terraform init` был
# воспроизводим на любой машине, а не просто "последняя версия ~> 5.0".

# Ansible
ansible/*.retry
ansible/inventory.ini
ansible/group_vars/all/secrets.yml
ansible/group_vars/vault.yml

# Kubernetes secrets (real ones must never be committed)
k8s/**/secret.yaml
!k8s/**/secret.example.yaml

# Jenkins
jenkins/**/credentials.xml

# OS / editor
.DS_Store
.idea/
.vscode/

# OSRM routing dataset (regenerated locally via osrm-extract/partition/customize, Фаза 1 шаг 4)
data/
