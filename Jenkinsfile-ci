// Jenkinsfile-ci
// Фаза 4, шаг 4.4: CI-пайплайн miklat-ci.
// Запускается автоматически по GitHub webhook (githubPush(), см. Job DSL в
// jenkins/values.yaml) либо вручную (Build Now).
//
// Логические части: checkout → validate (структура + Dockerfile lint) →
// lint → тесты (минимальный набор) → определение изменившихся сервисов →
// build&push через kaniko → publish metadata.
//
// Осознанное сужение: полный `pytest tests/` для бэкенд-сервисов требует
// живой Postgres+PostGIS с сид-данными — этого в CI-агенте нет и не
// планируется (агент собирается по требованию, без stateful-зависимостей).
// План явно говорит "тесты (минимальный набор)" — берём буквально: гоняем
// только tests/test_health.py, единственный тест, документированно не
// требующий БД. Полное интеграционное тестирование с БД — кандидат на
// будущее улучшение, не реализовано сейчас.
pipeline {
    agent { label 'ci-agent' }

    options {
        // timestamps() убран: это опция плагина Timestamper, которого нет в
        // additionalPlugins (см. jenkins/values.yaml) — без него Jenkins не
        // может распарсить options{} и падает ещё до checkout. Добавлять
        // отдельный плагин ради меток времени в логе не стали (см. журнал
        // прогресса, шаг 4.4) — чисто косметика, план этого не требует.
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        REGISTRY = 'ghcr.io'
        IMAGE_NS = 'algoldenberg'
    }

    stages {
        stage('Checkout') {
            steps {
                container('git') {
                    // Declarative Pipeline делает свой checkout ДО входа в
                    // container('git') (другой UID), затем наш checkout scm
                    // здесь перезаписывает файлы уже от имени UID контейнера
                    // alpine/git — git видит смену владельца и блокирует
                    // работу (защита от CVE-2022-24765). Помечаем workspace
                    // безопасным один раз здесь — контейнер 'git' живёт весь
                    // пайплайн, поэтому настройка действует и на более
                    // поздней стадии "Detect changed services".
                    sh 'git config --global --add safe.directory "*"'
                    checkout scm
                    script {
                        env.GIT_SHA = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    }
                }
            }
        }

        stage('Validate') {
            steps {
                container('python-tools') {
                    sh 'python3 ci/validate.py'
                }
            }
        }

        stage('Lint') {
            parallel {
                stage('Python') {
                    steps {
                        container('python-tools') {
                            sh '''
                                # Версия зафиксирована: без пина между сборками может
                                # незаметно поменяться дефолтный набор правил ruff (сами
                                # так и напоролись — 0.16.x стал по умолчанию проверять
                                # заметно больше, чем 0.15.x) — сборка начала бы падать
                                # без единого изменения в коде. --select ограничивает
                                # набор классическим E4,E7,E9,F (синтаксис, неиспользуемые
                                # импорты/переменные, undefined names) — то, что реально
                                # указывает на проблемы, а не стилевые предпочтения (это
                                # lint-стадия CI, а не отдельный шаг код-стайла).
                                pip install --quiet --no-cache-dir ruff==0.16.5
                                for svc in services/*/; do
                                    echo "== ruff: ${svc} =="
                                    ruff check --select E4,E7,E9,F "${svc}" || exit 1
                                done
                            '''
                        }
                    }
                }
                stage('Frontend') {
                    steps {
                        container('node-tools') {
                            dir('frontend') {
                                sh '''
                                    npm ci
                                    npx oxlint src/
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Tests') {
            parallel {
                stage('Python services') {
                    steps {
                        container('python-tools') {
                            sh '''
                                for svc in services/*/; do
                                    name=$(basename "$svc")
                                    if [ -f "${svc}tests/test_health.py" ]; then
                                        echo "== pytest (smoke): ${name} =="
                                        python3 -m venv "/tmp/venv-${name}"
                                        . "/tmp/venv-${name}/bin/activate"
                                        pip install --quiet --no-cache-dir -r "${svc}requirements.txt"
                                        # httpx - не рантайм-зависимость сервиса, а требование
                                        # starlette.testclient (fastapi.testclient.TestClient
                                        # использует его под капотом, начиная с версий, где
                                        # TestClient перешёл с requests на httpx) — нужен только
                                        # тестовому окружению, поэтому ставим отдельно здесь.
                                        pip install --quiet --no-cache-dir pytest httpx
                                        (cd "${svc}" && pytest tests/test_health.py -q)
                                        deactivate
                                    fi
                                done
                            '''
                        }
                    }
                }
                stage('Frontend build') {
                    steps {
                        container('node-tools') {
                            dir('frontend') {
                                sh 'npm run build'
                            }
                        }
                    }
                }
            }
        }

        stage('Detect changed services') {
            steps {
                container('git') {
                    script {
                        def allServices = ['frontend', 'miklat-gateway', 'miklat-service', 'miklat-comments', 'miklat-routes', 'miklat-walking-routes', 'miklat-photos']
                        def changed = []
                        def diffExit = sh(script: 'git rev-parse HEAD~1 >/dev/null 2>&1', returnStatus: true)
                        if (diffExit == 0) {
                            def changedFiles = sh(script: 'git diff --name-only HEAD~1 HEAD', returnStdout: true).trim().split('\n')
                            for (svc in allServices) {
                                def prefix = (svc == 'frontend') ? 'frontend/' : "services/${svc}/"
                                if (changedFiles.any { it.startsWith(prefix) }) {
                                    changed << svc
                                }
                            }
                        } else {
                            echo 'Нет предыдущего коммита для сравнения — собираем все сервисы.'
                            changed = allServices
                        }
                        env.CHANGED_SERVICES = changed.join(',')
                        echo "Изменившиеся сервисы: ${env.CHANGED_SERVICES}"
                    }
                }
            }
        }

        stage('Build & push (kaniko)') {
            when {
                expression { return env.CHANGED_SERVICES?.trim() }
            }
            steps {
                container('kaniko') {
                    withCredentials([usernamePassword(credentialsId: 'ghcr-credentials', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                        sh '''
                            mkdir -p /kaniko/.docker
                            AUTH=$(printf '%s:%s' "$REG_USER" "$REG_PASS" | base64 | tr -d '\\n')
                            cat > /kaniko/.docker/config.json <<EOF
{"auths":{"${REGISTRY}":{"auth":"${AUTH}"}}}
EOF
                        '''
                        script {
                            env.CHANGED_SERVICES.split(',').each { svc ->
                                def context = (svc == 'frontend') ? 'frontend' : "services/${svc}"
                                def image = "${env.REGISTRY}/${env.IMAGE_NS}/${svc}:${env.GIT_SHA}"
                                def digestFile = "/workspace/digest-${svc}.txt"
                                sh """
                                    echo '== kaniko: ${svc} -> ${image} =='
                                    /kaniko/executor \\
                                      --context=\$(pwd)/${context} \\
                                      --dockerfile=\$(pwd)/${context}/Dockerfile \\
                                      --destination=${image} \\
                                      --digest-file=${digestFile} \\
                                      --cache=true
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Publish metadata') {
            when {
                expression { return env.CHANGED_SERVICES?.trim() }
            }
            steps {
                container('kaniko') {
                    sh '''
                        echo "commit=${GIT_SHA}" > build-metadata.txt
                        for f in /workspace/digest-*.txt; do
                            [ -f "$f" ] || continue
                            svc=$(basename "$f" | sed 's/digest-//; s/.txt//')
                            echo "${svc}: ${REGISTRY}/${IMAGE_NS}/${svc}:${GIT_SHA} @ $(cat $f)" >> build-metadata.txt
                        done
                        cat build-metadata.txt
                    '''
                }
                archiveArtifacts artifacts: 'build-metadata.txt', allowEmptyArchive: true
            }
        }

        stage('Trigger CD') {
            // Фаза 4, шаг 6: автоматическая связка CI->CD. Для каждого
            // изменившегося сервиса запускаем downstream job miklat-cd с
            // теми же тремя параметрами, которые он ожидает (см.
            // Jenkinsfile-cd/jobDsl в jenkins/values.yaml): SERVICE_NAME
            // (то же самое имя, что уже посчитано в CHANGED_SERVICES —
            // ровно тот же список значений, что и choiceParam у miklat-cd),
            // IMAGE_TAG (тот же GIT_SHA, которым kaniko только что
            // реально тегировал и запушило образ) и IMAGE_DIGEST (для
            // traceability в логах CD, не участвует в самом деплое).
            //
            // Читаем digest-файл именно внутри container('kaniko') — то же
            // самое место, откуда его уже читает стадия Publish metadata
            // (те файлы физически лежат в файловой системе САМОГО
            // контейнера kaniko, а не в общем workspace-volume, который у
            // всех контейнеров пода смонтирован на /home/jenkins/agent —
            // из другого контейнера их не увидеть).
            //
            // wait: false (без propagate — он влияет только на поведение
            // ожидания результата, а без wait не используется) — CI и CD
            // сознательно разделены (см. principle CI/CD separation в
            // README): CI считает свою работу выполненной, как только
            // образ собран, запушен и job деплоя поставлен в очередь;
            // сам деплой, его rollout/verify/smoke-test и explicit
            // rollback — целиком зона ответственности Jenkinsfile-cd,
            // со своим отдельным Console Output. Не делаем CI пайплайн
            // заложником длительности helm upgrade --wait/rollback CD
            // (у miklat-cd свои собственные таймауты).
            when {
                expression { return env.CHANGED_SERVICES?.trim() }
            }
            steps {
                container('kaniko') {
                    script {
                        env.CHANGED_SERVICES.split(',').each { svc ->
                            def digestFile = "/workspace/digest-${svc}.txt"
                            def digest = sh(script: "cat ${digestFile}", returnStdout: true).trim()
                            echo "Запускаю miklat-cd: SERVICE_NAME=${svc} IMAGE_TAG=${env.GIT_SHA} IMAGE_DIGEST=${digest}"
                            build job: 'miklat-cd',
                                  parameters: [
                                      string(name: 'SERVICE_NAME', value: svc),
                                      string(name: 'IMAGE_TAG', value: env.GIT_SHA),
                                      string(name: 'IMAGE_DIGEST', value: digest)
                                  ],
                                  wait: false
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Сборка commit=${env.GIT_SHA} завершена со статусом ${currentBuild.currentResult}"
        }
    }
}