{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3PhotosObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::miklat-photos-tf-232779827681/*"
    },
    {
      "Sid": "S3ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::miklat-photos-tf-232779827681"
    },
    {
      "Sid": "SNSPublish",
      "Effect": "Allow",
      "Action": ["sns:Publish", "sns:GetTopicAttributes"],
      "Resource": "arn:aws:sns:il-central-1:232779827681:miklat-notifications-tf"
    }
  ]
}
